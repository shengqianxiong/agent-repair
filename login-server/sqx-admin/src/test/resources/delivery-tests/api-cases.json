{
  "description": "极简登录项目 API 集成测试（MockMvc）",
  "contextPath": "/sqx_fast",
  "cases": [
    {
      "name": "管理员登录-成功",
      "method": "POST",
      "path": "/admin/auth/login",
      "body": {
        "account": "admin",
        "password": "admin123"
      },
      "expectCode": 0
    },
    {
      "name": "管理员登录-密码错误",
      "method": "POST",
      "path": "/admin/auth/login",
      "body": {
        "account": "admin",
        "password": "wrong"
      },
      "expectCode": 500
    },
    {
      "name": "账号列表-未登录",
      "method": "GET",
      "path": "/admin/account/list",
      "expectCode": 401
    },
    {
      "name": "账号列表-已登录",
      "method": "GET",
      "path": "/admin/account/list",
      "auth": "admin",
      "expectCode": 0
    },
    {
      "name": "账号列表-关键词筛选",
      "method": "GET",
      "path": "/admin/account/list?account=admin",
      "auth": "admin",
      "expectCode": 0
    },
    {
      "name": "账号详情-已登录",
      "method": "GET",
      "path": "/admin/account/detail/1",
      "auth": "admin",
      "expectCode": 0
    },
    {
      "name": "账号详情-不存在",
      "method": "GET",
      "path": "/admin/account/detail/9999",
      "auth": "admin",
      "expectCode": 500
    },
    {
      "name": "用户端登录-成功",
      "method": "POST",
      "path": "/app/user/login",
      "body": {
        "account": "user",
        "password": "user123"
      },
      "expectCode": 0
    },
    {
      "name": "用户端登录-普通用户不可登录管理端",
      "method": "POST",
      "path": "/admin/auth/login",
      "body": {
        "account": "user",
        "password": "user123"
      },
      "expectCode": 403
    }
  ]
}
