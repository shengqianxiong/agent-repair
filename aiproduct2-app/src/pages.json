{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "旧衣回收",
        "navigationStyle": "custom",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/reserve/index",
      "style": {
        "navigationBarTitleText": "预约上门",
        "navigationBarTextStyle": "black",
        "navigationBarBackgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/order/index",
      "style": {
        "navigationBarTitleText": "我的订单",
        "navigationBarTextStyle": "black",
        "navigationBarBackgroundColor": "#FFFFFF",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/reward/index",
      "style": {
        "navigationBarTitleText": "奖励中心",
        "navigationBarTextStyle": "black",
        "navigationBarBackgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/reward/redeem",
      "style": {
        "navigationBarTitleText": "兑换礼品",
        "navigationBarTextStyle": "black",
        "navigationBarBackgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/certificate/index",
      "style": {
        "navigationBarTitleText": "我的公益证书",
        "navigationBarTextStyle": "black",
        "navigationBarBackgroundColor": "#FFFFFF"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationBarTextStyle": "black",
        "navigationBarBackgroundColor": "#FFFFFF"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "aiProduct2",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F4F6F8"
  },
  "tabBar": {
    "color": "#9AA0A6",
    "selectedColor": "#2EAE5E",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/order/index",
        "text": "订单"
      },
      {
        "pagePath": "pages/reward/index",
        "text": "奖励"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的"
      }
    ]
  }
}
